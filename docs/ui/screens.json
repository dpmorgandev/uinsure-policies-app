      "loading": "trace.json (or a lazy chunk such as a diff) is being fetched",
      "error": "trace.json failed to load or failed its schema check; names what failed, never a blank page",
      "empty": "the entity exists but has no items (e.g. F0b's Rules table, findings: [])",
      "in-flight": "the node is in progress (F3 at the snapshot): shows what exists, marked in progress",
      "incomplete": "TRAIL INCOMPLETE: <reasons>, shown verbatim and first",
      "git-only": "OK (git-only, F0a): no loop, activity or verdicts, by design",
      "not-built": "the rule or node isn't built yet: the not-built-yet pattern, never a failure",
      "disagreement": "two sources disagree (e.g. README 'merge pending' vs a merged event): both shown, the event-derived value first",
      "redacted": "<user>, <outside-repo>, <root> kept and labelled as redactions",
      "long-content": "root causes 1-3k chars, details up to ~600, commands truncated at ~200: collapsed with a full-text disclosure",
      "api-error": "the API answered with a problem (400/404/409/422/429/500): rendered from its ProblemDetails, never a generic failure",
      "api-unreachable": "the API is not running or the proxy failed: says so, names the base URL, and how to start it",
      "api-not-built": "the endpoint is not in the API yet (renew until F4 merges): the not-built-yet pattern, never a failure",
      "submitting": "a process is running (a request, a quote, a lazy load): the control that started it shows a spinner, says what is happening, and is disabled until it ends; the form keeps its values (BUSY-1)"
