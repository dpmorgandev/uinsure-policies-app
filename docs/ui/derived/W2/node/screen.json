  "actions": [
    {
      "label": "Open the walkthrough (primary on populated and git-only: the commits in order)",
      "kind": "link",
      "to": "/plans/:planId/:nodeId/commits"
    },
    {
      "label": "Open the loop log (primary on in-flight and disagreement)",
      "kind": "link",
      "to": "/plans/:planId/:nodeId/loop"
    },
    {
      "label": "Open the activity",
      "kind": "link",
      "to": "/plans/:planId/:nodeId/activity"
    },
    {
      "label": "Switch node view (tabs: Node, Walkthrough, Loop, Activity)",
      "kind": "link",
      "to": "/plans/:planId/:nodeId, /commits, /loop, /activity"
    },
    {
      "label": "Open a rule (rule chip in the rules region)",
      "kind": "link",
      "to": "/rules/:ruleId"
    },
    {
      "label": "Open the plan (breadcrumbs, empty states, tasks gap)",
      "kind": "link",
      "to": "/plans/:planId"
    },
    {
      "label": "Open a commit or the pull request on GitHub (SHA links, PR #20)",
      "kind": "link",
      "to": "https://github.com/dpmorgandev/uinsure-policies-api/commit/:sha, https://github.com/dpmorgandev/uinsure-policies-api/pull/:number"
    },
    {
      "label": "Jump from the investigation branch back to its attempt (rejoin link)",
      "kind": "link",
      "to": "#attempt rung on this page"
    },
    {
      "label": "Move rung to rung with J and K",
      "kind": "control",
      "to": "client-side keyboard focus; sends no request"
    },
    {
      "label": "Copy command (verify-command)",
      "kind": "control",
      "to": "client-side clipboard copy; sends no request"
    },
    {
      "label": "Sort a table by its first column",
      "kind": "control",
      "to": "client-side sort of the loaded rows; sends no request"
    }
  ]
