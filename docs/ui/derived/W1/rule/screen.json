  "states": [
    {
      "name": "populated",
      "file": "populated.html",
      "variant": "the ref's own data: rules[id=GET-1] in build/F2, three attempts, red at #5, green at #17"
    },
    {
      "name": "not-built",
      "file": "not-built.html",
      "variant": "the kit's labelled placeholders (‹ruleId›, ‹region›, PLACEHOLDER-1), attached to no real rule or node: every rule in the fixture is built"
    },
    {
      "name": "long-content",
      "file": "long-content.html",
      "variant": "rules[id=COULD-2] in build/F3: nine commits, the longest trail, no green commit recorded; no layer, gate, QA result or verdict for F3 in the excerpt; the diff is the kit's labelled long-diff placeholder"
    },
    {
      "name": "submitting",
      "file": "submitting.html",
      "variant": "the populated data with the red diff's load control in flight (BUSY-1)"
    }
  ],
  "actions": [
    {
      "label": "Load red diff",
      "kind": "request",
      "to": "GET the red commit's chunk of trace/build/F2/diffs.json"
    },
    {
      "label": "Load green diff",
      "kind": "request",
      "to": "GET the green commit's chunk of trace/build/F2/diffs.json"
    },
    {
      "label": "Copy command",
      "kind": "control",
      "to": "copies the verify command to the clipboard; sends no request"
    },
    {
      "label": "Show UTC time",
      "kind": "control",
      "to": "toggles the time zone of a timestamp; sends no request"
    },
    {
      "label": "Text equivalent: the commit rungs as a table",
      "kind": "control",
      "to": "opens the table beside the rung spine; sends no request"
    },
