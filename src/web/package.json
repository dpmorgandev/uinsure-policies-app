{
  "name": "docket-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:css": "stylelint \"{app,kit}/**/*.css\"",
    "test": "vitest run --config vite.config.ts --passWithNoTests tests/web/unit",
    "test:kit": "vitest run --config vite.config.ts",
    "e2e": "playwright test",
    "trace": "node compiler/index.ts --ref HEAD"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.59.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "jsdom": "30.1.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "stylelint": "17.16.0",
    "@playwright/test": "1.62.0",
    "@axe-core/playwright": "4.14.0",
    "eslint": "10.13.0",
    "typescript-eslint": "8.72.0",
    "eslint-plugin-react-hooks": "7.1.1"
  }
}
