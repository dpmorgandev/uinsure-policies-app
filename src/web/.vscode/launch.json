{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Vite dev server",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
      "args": ["--port", "4170", "--strictPort", "--open"]
    },
    {
      "name": "localhost (Edge)",
      "type": "edge",
      "request": "launch",
      "url": "http://localhost:4170",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
