  "radius": {
    "$type": "dimension",
    "$value": "2px"
  },
  "duration": {
    "short": {
      "$type": "duration",
      "$value": "120ms"
    },
    "medium": {
      "$type": "duration",
      "$value": "200ms"
    }
  }
