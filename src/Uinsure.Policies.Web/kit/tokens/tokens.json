{
  "color": {
    "background": {
      "$type": "color",
      "$value": "#ffffff",
      "$extensions": {
        "dark": "#1b1d21",
        "source": "proposed"
      }
    },
    "surface": {
      "$type": "color",
      "$value": "#f3f3f3",
      "$extensions": {
        "dark": "#24272c",
        "source": "K1 light grey (light); dark proposed"
      }
    },
    "border": {
      "$type": "color",
      "$value": "#cecece",
      "$extensions": {
        "dark": "#3b4048",
        "source": "K1 (light); dark proposed"
      }
    },
    "accent": {
      "$type": "color",
      "$value": "#d5e7ec",
      "$extensions": {
        "dark": "#1f3a42",
        "source": "proposed"
      }
    },
    "textPrimary": {
      "$type": "color",
      "$value": "#1b1f24",
      "$extensions": {
        "dark": "#ececec",
        "source": "proposed"
      }
    },
    "textSecondary": {
      "$type": "color",
      "$value": "#555b62",
      "$extensions": {
        "dark": "#a3a9b0",
        "source": "proposed"
      }
    },
    "primary": {
      "$type": "color",
      "$value": "#165f73",
      "$extensions": {
        "dark": "#6fc3d6",
        "source": "proposed"
      }
    },
    "error": {
      "$type": "color",
      "$value": "#ca3535",
      "$extensions": {
        "dark": "#fb747b",
        "source": "K1 (light); K2 inverse error (dark)"
      }
    },
    "success": {
      "$type": "color",
      "$value": "#0f7a52",
      "$extensions": {
        "dark": "#42be65",
        "source": "K1 (light); K2 inverse success (dark)"
      }
    },
    "warn": {
      "$type": "color",
      "$value": "#8a5a00",
      "$extensions": {
        "dark": "#f1c21b",
        "source": "K2 support-warning (dark); light proposed"
      }
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Atkinson Hyperlegible Next",
        "system-ui",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Atkinson Hyperlegible Mono",
        "ui-monospace",
        "monospace"
      ]
    }
  },
  "size": {
    "text-12": {
      "$type": "dimension",
      "$value": "0.75rem"
    },
    "text-14": {
      "$type": "dimension",
      "$value": "0.875rem"
    },
    "text-16": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "text-18": {
      "$type": "dimension",
      "$value": "1.125rem"
    },
    "text-24": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "text-32": {
      "$type": "dimension",
      "$value": "2rem"
    }
  },
  "space": {
    "space-1": {
      "$type": "dimension",
      "$value": "0.25rem"
    },
    "space-2": {
      "$type": "dimension",
      "$value": "0.5rem"
    },
    "space-3": {
      "$type": "dimension",
      "$value": "0.75rem"
    },
    "space-4": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "space-5": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "space-6": {
      "$type": "dimension",
      "$value": "2rem"
    },
    "space-7": {
      "$type": "dimension",
      "$value": "3rem"
    }
