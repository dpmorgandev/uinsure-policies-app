<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.2752196">
  <PropertyGroup>
    <!-- F5 runs the Vite dev server; its /api proxy defaults to the API's http profile on port 5080. -->
    <StartupCommand>npx vite --port 4170 --strictPort</StartupCommand>
    <JavaScriptTestRoot>..\..\tests\Uinsure.Policies.Web.Tests\</JavaScriptTestRoot>
    <JavaScriptTestFramework>Vitest</JavaScriptTestFramework>
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
    <BuildOutputFolder>$(MSBuildProjectDirectory)\dist</BuildOutputFolder>
  </PropertyGroup>
</Project>
