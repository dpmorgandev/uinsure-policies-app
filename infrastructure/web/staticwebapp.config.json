{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.json", "/*.ico", "/kitchen-sink.html"]
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; style-src 'self' 'unsafe-inline'; base-uri 'self'; form-action 'none'; object-src 'none'",
    "X-Content-Type-Options": "nosniff"
  }
}
